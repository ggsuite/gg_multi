{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "gg_multi",

  // 1-2 sentence summary about this repo.
  "summary": "Umbrella of the gg_multi tool family: wires the can/did/do command tree, ships the gg_multi executable and re-exports the sub-packages.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "command tree: GgMulti with can, did, do; do upgrade (deps, ocean)",
    "public API: re-exports gg_multi_core, _commit, _do_publish, _workspace, _maintain (DoMaintain)",
    "version pins of the sub-packages that compile together"
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "gg_multi_core": "workspace model, GgRc, ReadSettings, ggCliVersion; re-exported",
      "gg_multi_commit": "can/did/do commit, push, review, do upgrade deps; re-exported",
      "gg_multi_do_publish": "do publish, can publish; re-exported",
      "gg_multi_workspace": "do add, create, rm, ls, upgrade ocean, AddReposBetween; re-exported",
      "gg_multi_maintain": "do maintain (DoMaintain only)",
      "gg_one": "single-repo commands the flows delegate to",
      "gg_args": "DirCommand, GgCommandRunner",
      "gg_log": "GgLog"
    },

    // "<repo-b>": "why / API"
    "usedBy": {
      "gg": "can/did/do subcommands at the gg root, ggCliVersion"
    }
  }
}
